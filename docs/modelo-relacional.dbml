Table users {
  id uuid [pk]
  email text [unique, not null]
  password text [not null]
  name text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table authors {
  id uuid [pk]
  name text [unique, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table publishers {
  id uuid [pk]
  name text [unique, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table genres {
  id uuid [pk]
  name text [unique, not null]
}

Table books {
  id uuid [pk]
  title text [not null]
  price decimal(10,2) [not null]
  stock int [not null]
  image_url text
  author_id uuid [not null]
  publisher_id uuid [not null]
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    title
    author_id
    publisher_id
    deleted_at
    stock
    price
    created_at
  }
}

Table book_genres {
  book_id uuid [pk]
  genre_id uuid [pk]

  indexes {
    genre_id
  }
}

Table audit_logs {
  id uuid [pk]
  action text [not null]
  entity text [not null]
  entity_id uuid
  user_id uuid
  metadata jsonb
  ip text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (entity, entity_id)
    user_id
    created_at
  }
}

Ref: books.author_id > authors.id [delete: restrict, update: cascade]
Ref: books.publisher_id > publishers.id [delete: restrict, update: cascade]
Ref: book_genres.book_id > books.id [delete: cascade, update: cascade]
Ref: book_genres.genre_id > genres.id [delete: restrict, update: cascade]
Ref: audit_logs.user_id > users.id [delete: set null, update: cascade]
